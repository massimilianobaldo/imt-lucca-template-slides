% -----------------------------------------------------------------------------
% beamerthemeimtlucca - Beamer theme following the IMT Lucca visual identity.
%
%   \usetheme[<options>]{imtlucca}
%
% Options
%   sectionpages=true|false   Full-page divider before every \section (default true)
%   footer=true|false         Footer on regular slides (default true)
%   assetpath=<dir>           Where the logo files live, with trailing slash
%                             (default assets/; set it empty when the theme and
%                             its logos are installed in a texmf tree)
%
% User macros
%   \imtlogo[<height>]{<file>}    Primary title-slide logo (default: IMT, 12mm)
%   \imtcologo[<height>]{<file>}  Optional co-institution logo, empty by default
%                                 A single logo sits at the top right; with a
%                                 co-institution logo the primary one moves to
%                                 the top left and the second stays on the right.
%   \IMTLogo, \IMTLogoVertical    Paths to the bundled IMT logos
%   \highlight{...}, \bluehighlight{...}, takeawaybox environment
%   \begin{recap} \recapitem{<label>}{<text>} ... \end{recap}
%                                     One-slide summary: labelled panels laid
%                                     out two per row, all the same size.
%   \begin{leanbox}{<kind>}{<name>}   Result formalized in Lean; the Lean logo
%                                     is shown at the right of the title bar.
%                                     Leave <name> empty to omit the parentheses.
%
% Pass an empty file name to drop a logo, e.g. \imtlogo{} for no logos at all.
%
% The theme loads tcolorbox without package options; add tcolorbox libraries
% with \tcbuselibrary{...} rather than \usepackage[...]{tcolorbox}, which would
% raise an option clash.
% -----------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeimtlucca}[2026/09/08 v1.0 IMT Lucca beamer theme]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=imt,prefix=imt@}
\DeclareBoolOption[true]{sectionpages}
\DeclareBoolOption[true]{footer}
\DeclareStringOption[assets/]{assetpath}
\ProcessKeyvalOptions*

% -----------------------------------------------------------------------------
% Font setup: Inter, compatible with pdfLaTeX through the CTAN package `inter`.
% If `inter` is missing in your TeX distribution, the theme falls back to
% Latin Modern Sans so that it still compiles.
% -----------------------------------------------------------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\IfFileExists{inter.sty}{%
  \RequirePackage[sfdefault,semibold,scaled=0.98]{inter}%
}{%
  \RequirePackage{lmodern}%
  \renewcommand{\familydefault}{\sfdefault}%
}
\usefonttheme{professionalfonts}

% -----------------------------------------------------------------------------
% Packages the theme itself needs
% -----------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,raster}

% -----------------------------------------------------------------------------
% Logo assets. File names are resolved against assetpath, so a bare file name
% is also found by kpathsea when the logos sit in a texmf tree.
% -----------------------------------------------------------------------------
\newcommand{\IMTLogo}{\imt@assetpath imt_lucca_horizontal.pdf}
\newcommand{\IMTLogoVertical}{\imt@assetpath imt_lucca_vertical.pdf}

\def\imt@logofile{imt_lucca_vertical.pdf}
\def\imt@logoheight{12mm}
\newcommand{\imtlogo}[2][12mm]{%
  \def\imt@logoheight{#1}%
  \def\imt@logofile{#2}%
}

\def\imt@cologofile{}
\def\imt@cologoheight{13mm}
\newcommand{\imtcologo}[2][13mm]{%
  \def\imt@cologoheight{#1}%
  \def\imt@cologofile{#2}%
}

% -----------------------------------------------------------------------------
% IMT visual identity colors
% -----------------------------------------------------------------------------
\definecolor{IMTDarkBlue}{HTML}{002A48}
\definecolor{IMTOrange}{HTML}{FF8300}
\definecolor{IMTAccentBlue}{HTML}{00698F}
\definecolor{IMTBackground}{HTML}{F2F2F2}
\definecolor{IMTBlack}{HTML}{000000}
\definecolor{IMTMutedText}{HTML}{59636B}
\definecolor{IMTRule}{HTML}{D9D9D9}

% -----------------------------------------------------------------------------
% Beamer theme setup
% -----------------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=9mm,text margin right=9mm}
\usetheme{default}

\setbeamercolor{normal text}{fg=IMTBlack,bg=white}
\setbeamercolor{structure}{fg=IMTDarkBlue}
\setbeamercolor{alerted text}{fg=IMTOrange}
\setbeamercolor{title}{fg=IMTDarkBlue}
\setbeamercolor{subtitle}{fg=IMTAccentBlue}
\setbeamercolor{author}{fg=IMTBlack}
\setbeamercolor{institute}{fg=IMTMutedText}
\setbeamercolor{date}{fg=IMTMutedText}
\setbeamercolor{frametitle}{fg=IMTDarkBlue,bg=white}
\setbeamercolor{framesubtitle}{fg=IMTMutedText,bg=white}
\setbeamercolor{footline}{fg=IMTDarkBlue,bg=white}
\setbeamercolor{section in toc}{fg=IMTDarkBlue}
\setbeamercolor{subsection in toc}{fg=IMTMutedText}
\setbeamercolor{block title}{fg=white,bg=IMTDarkBlue}
\setbeamercolor{block body}{fg=IMTBlack,bg=IMTBackground}
\setbeamercolor{block title alerted}{fg=white,bg=IMTOrange}
\setbeamercolor{block body alerted}{fg=IMTBlack,bg=IMTBackground}
\setbeamercolor{block title example}{fg=white,bg=IMTAccentBlue}
\setbeamercolor{block body example}{fg=IMTBlack,bg=IMTBackground}

\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\mdseries}
\setbeamerfont{author}{size=\normalsize,series=\mdseries}
\setbeamerfont{institute}{size=\small,series=\mdseries}
\setbeamerfont{date}{size=\small,series=\mdseries}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,series=\mdseries}
\setbeamerfont{footline}{size=\scriptsize,series=\mdseries}
\setbeamerfont{block title}{series=\bfseries}

% Cleaner bullets.
\setbeamertemplate{itemize item}{\textcolor{IMTOrange}{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\textcolor{IMTAccentBlue}{\tiny$\blacktriangleright$}}
\setbeamertemplate{enumerate item}{\textcolor{IMTOrange}{\insertenumlabel.}}
\setbeamertemplate{section in toc}[sections numbered]

% -----------------------------------------------------------------------------
% Title page
% -----------------------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    % Thin institutional rule at the top.
    \fill[IMTDarkBlue] (current page.north west) rectangle ([yshift=-0.9mm]current page.north east);
    \fill[IMTOrange] ([yshift=-0.9mm]current page.north west) rectangle ([xshift=42mm,yshift=-2.4mm]current page.north west);

    % A single logo sits at the top right. With a co-institution logo the two
    % marks take a corner each: the primary one on the left, the second on the
    % right, both inset by the same 8mm.
    \ifx\imt@cologofile\@empty
      \ifx\imt@logofile\@empty\else
        \node[anchor=north east,inner sep=0pt]
          at ([xshift=-8mm,yshift=-7.5mm]current page.north east)
          {\includegraphics[height=\imt@logoheight]{\imt@assetpath\imt@logofile}};
      \fi
    \else
      \ifx\imt@logofile\@empty
        \node[anchor=north east,inner sep=0pt]
          at ([xshift=-8mm,yshift=-7.5mm]current page.north east)
          {\includegraphics[height=\imt@cologoheight]{\imt@assetpath\imt@cologofile}};
      \else
        \node[anchor=north west,inner sep=0pt]
          at ([xshift=8mm,yshift=-7.5mm]current page.north west)
          {\includegraphics[height=\imt@logoheight]{\imt@assetpath\imt@logofile}};
        \node[anchor=north east,inner sep=0pt]
          at ([xshift=-8mm,yshift=-7.5mm]current page.north east)
          {\includegraphics[height=\imt@cologoheight]{\imt@assetpath\imt@cologofile}};
      \fi
    \fi

    % Main title block centered relative to the whole slide, not shifted by logos.
    \node[anchor=center,inner sep=0pt,text width=.90\paperwidth,align=center]
      at ([yshift=-2mm]current page.center) {%
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
        {\color{IMTOrange}\rule{18mm}{1.1pt}}\hspace{1.5mm}{\color{IMTAccentBlue}\rule{34mm}{1.1pt}}\par%
        \vspace{4mm}%
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
        \vspace{8mm}%
        {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
        \vspace{2mm}%
        {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}%
        \vspace{4mm}%
        {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}%
      };

    % Bottom accent, consistent with the IMT visual language but kept clean.
    \fill[IMTBackground] ([yshift=10.5mm]current page.south west) rectangle (current page.south east);
    \fill[IMTDarkBlue] (current page.south west) rectangle ([xshift=.70\paperwidth,yshift=2.2mm]current page.south west);
    \fill[IMTOrange] ([xshift=.70\paperwidth]current page.south west) rectangle ([yshift=2.2mm]current page.south east);
  \end{tikzpicture}%
  \null
}

% -----------------------------------------------------------------------------
% Frame titles
% The color rule is inside a beamercolorbox with the same left margin as the
% title, so it starts exactly aligned with the title text.
% -----------------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace{3mm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=9mm,rightskip=9mm,ht=8mm,dp=1.5mm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else%
      \par{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}%
    \fi%
  \end{beamercolorbox}%
  \vspace{-0.5mm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=9mm,rightskip=9mm,ht=1.1mm,dp=0mm]{normal text}
    \color{IMTOrange}\rule{13mm}{0.9pt}%
    \color{IMTAccentBlue}\rule{45mm}{0.9pt}%
  \end{beamercolorbox}%
  \vspace{2mm}%
}

% -----------------------------------------------------------------------------
% Footline: no logos on regular slides.
% Left: speaker name. Center: short title. Right: slide number.
% -----------------------------------------------------------------------------
\ifimt@footer
  \setbeamertemplate{footline}{%
    \ifnum\value{framenumber}>0%
      \begin{tikzpicture}[remember picture,overlay]
        \draw[IMTBackground,line width=0.5pt]
          ([xshift=7mm,yshift=8.0mm]current page.south west) --
          ([xshift=-7mm,yshift=8.0mm]current page.south east);
      \end{tikzpicture}%
      \begin{beamercolorbox}[wd=\paperwidth,ht=7.7mm,dp=2.0mm,leftskip=7mm,rightskip=7mm]{footline}
        \vbox to 7.2mm{\vfill%
          \hbox to \dimexpr\paperwidth-14mm\relax{%
            \rlap{\usebeamerfont{footline}\insertshortauthor}%
            \hfil{\usebeamerfont{footline}\insertshorttitle}\hfil%
            \llap{\usebeamerfont{footline}\insertframenumber{} / \inserttotalframenumber}%
          }%
          \vfill}%
      \end{beamercolorbox}%
    \fi%
  }
\else
  \setbeamertemplate{footline}{}
\fi

% -----------------------------------------------------------------------------
% Section divider pages
% -----------------------------------------------------------------------------
\ifimt@sectionpages
  \AtBeginSection[]{%
    \begin{frame}[plain,noframenumbering]
      \begin{tikzpicture}[remember picture,overlay]
        \fill[white] (current page.south west) rectangle (current page.north east);
        \fill[IMTDarkBlue] ([yshift=-0.9mm]current page.north west) rectangle (current page.north east);
        \fill[IMTOrange] ([yshift=-2.4mm]current page.north west) rectangle ([xshift=40mm,yshift=-0.9mm]current page.north west);
        \node[anchor=south west,align=left,text=IMTDarkBlue]
          at ([xshift=14mm,yshift=28mm]current page.south west)
          {\usebeamerfont{title}\insertsectionhead};
        \draw[IMTOrange,line width=1.1pt]
          ([xshift=14mm,yshift=24mm]current page.south west) --
          ([xshift=45mm,yshift=24mm]current page.south west);
        \draw[IMTAccentBlue,line width=1.1pt]
          ([xshift=45mm,yshift=24mm]current page.south west) --
          ([xshift=98mm,yshift=24mm]current page.south west);
      \end{tikzpicture}
    \end{frame}
  }
\fi

% -----------------------------------------------------------------------------
% Small helper environments/macros
% -----------------------------------------------------------------------------
\newcommand{\highlight}[1]{\textcolor{IMTOrange}{#1}}
\newcommand{\bluehighlight}[1]{\textcolor{IMTAccentBlue}{#1}}

\newenvironment{takeawaybox}{%
  \begin{beamercolorbox}[wd=\textwidth,rounded=true,sep=1.2ex]{block body}
  \textbf{Takeaway.}\;}{%
  \end{beamercolorbox}}

% -----------------------------------------------------------------------------
% Results formalized in the Lean proof assistant
%
%   \begin{leanbox}{Theorem}{Soundness} ... \end{leanbox}
%   \begin{leanbox}{Lemma}{} ... \end{leanbox}
%
% The Lean logo is a registered trademark of the Lean Focused Research
% Organization. The bundled file is the official artwork, used unmodified: it is
% thin black line art, so it sits on a white field inside the dark title bar
% rather than being recolored, and the trademark symbol is left in place.
% -----------------------------------------------------------------------------
\def\imt@leanlogo{lean_logo.png}

% " (name)" when a name is given, nothing when it is empty.
\newcommand{\imt@leanname}[1]{\ifblank{#1}{}{\ (#1)}}

\newtcolorbox{leanbox}[2]{%
  enhanced,
  colback=IMTBackground,
  colframe=IMTDarkBlue,
  colbacktitle=IMTDarkBlue,
  coltitle=white,
  fonttitle=\bfseries,
  boxrule=0.6pt,
  arc=1.5pt,
  left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm,
  % righttitle keeps a long title from running under the badge; the vertical
  % title padding keeps the badge inside the bar.
  lefttitle=2.5mm,righttitle=20mm,toptitle=1.2mm,bottomtitle=1.2mm,
  title={#1\imt@leanname{#2}},
  overlay={%
    \node[anchor=east,fill=white,rounded corners=0.8pt,
          inner xsep=0.4mm,inner ysep=0.4mm,outer sep=0pt]
      at ([xshift=-2.5mm]title.east)
      {\includegraphics[width=15mm]{\imt@assetpath\imt@leanlogo}};%
  },
}

% -----------------------------------------------------------------------------
% Recap grid: labelled panels, two per row, for a one-slide summary
%
%   \begin{recap}
%     \recapitem{Problem}{One sentence.}
%     \recapitem{Methodology}{One sentence.}
%     \recapitem{Results}{One sentence.}
%     \recapitem{Conclusions}{One sentence.}
%   \end{recap}
%
% All panels are given the same height and width, so the grid stays aligned
% however unevenly the text falls. Any number of panels works: three give one
% full row plus one panel, six give three rows. Bodies are set ragged right
% because justified text stretches badly in a column this narrow.
%
% Panels are sized to their content, not to the slide. Put \vfill before and
% after the environment to centre the grid in the frame body.
% -----------------------------------------------------------------------------
\tcbset{
  imt@recappanel/.style={
    enhanced,
    colback=IMTBackground,
    colframe=IMTDarkBlue,
    colbacktitle=IMTDarkBlue,
    coltitle=white,
    fonttitle=\bfseries\small,
    boxrule=0.6pt,
    arc=1.5pt,
    halign=flush left,
    left=2mm,right=2mm,top=1.5mm,bottom=1.5mm,
    lefttitle=2mm,righttitle=2mm,toptitle=0.8mm,bottomtitle=0.8mm,
  },
}

\newenvironment{recap}{%
  \begin{tcbraster}[
    raster columns=2,
    raster equal height,
    raster column skip=2.5mm,
    raster row skip=2.5mm,
    raster left skip=0mm,
    raster right skip=0mm,
  ]%
}{%
  \end{tcbraster}%
}

\newcommand{\recapitem}[2]{%
  \begin{tcolorbox}[imt@recappanel,title={#1}]#2\end{tcolorbox}%
}

\endinput
