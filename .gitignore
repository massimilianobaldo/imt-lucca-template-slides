*.fls
*.log
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv

# latexindent backups
*.bak[0-9]*

# Temporary / backup files
*.bak
*.tmp
*~
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
